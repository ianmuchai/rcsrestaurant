{
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "vercel-public",
    "headers": [
        {
            "source": "/",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/html; charset=utf-8"
                },
                {
                    "key": "Content-Disposition",
                    "value": "inline"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/html; charset=utf-8"
                },
                {
                    "key": "Content-Disposition",
                    "value": "inline"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
